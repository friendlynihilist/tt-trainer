    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/svelte": "^1.73.0",
    "canvas-confetti": "1.9.4",
    "firebase": "^13.4.0"
  }
}
