rules_version = '2';

// Ognuno legge e scrive solo i propri dati (l'unica eccezione è la posta in arrivo, più sotto).
// Il gruppo è su invito:
// config/access elenca chi può entrare; il primo che accede lo crea e ne diventa amministratore.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email;
    }
    function accessPath() {
      return /databases/$(database)/documents/config/access;
    }
    function hasAccess() {
      return exists(accessPath());
    }
    function access() {
      return get(accessPath()).data;
    }
    function isAdmin() {
      return signedIn() && hasAccess() && email() in access().admins;
    }
    function isMember() {
      return signedIn() && hasAccess() && (email() in access().admins || email() in access().emails);
    }

    match /config/access {
      // L'elenco di chi può entrare contiene le email: lo leggono solo gli amministratori.
      // (Chi non riesce a leggerlo ma legge i propri dati sa di essere un membro: vedi cloud.js.)
      allow get: if isAdmin();
      // Primo avvio: chi crea il documento deve mettersi come unico amministratore.
      allow create: if signedIn() && !hasAccess()
        && request.resource.data.admins == [email()]
        && request.resource.data.emails == [];
      // Un amministratore non può togliersi da solo dagli amministratori.
      allow update: if isAdmin() && email() in request.resource.data.admins;
    }

    // Un testo corto, oppure assente.
    function shortText(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }

    // Richieste di accesso: ciascuno scrive la propria, gli amministratori le vedono e le chiudono.
    // Solo email, nome, foto e data, e niente testi lunghi: chiunque abbia un account può scriverne una.
    match /requests/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == email()
        && request.resource.data.keys().hasOnly(['email', 'name', 'photo', 'at'])
        && shortText(request.resource.data, 'name', 120)
        && shortText(request.resource.data, 'photo', 500)
        && (!('at' in request.resource.data) || request.resource.data.at is number);
      allow list, delete: if isAdmin();
    }

    // Dati personali: impostazioni, piano, attività, note per colpo.
    match /users/{uid} {
      allow read, write: if isMember() && request.auth.uid == uid;
      match /events/{id} {
        allow read, write: if isMember() && request.auth.uid == uid;
      }
      match /notes/{id} {
        allow read, write: if isMember() && request.auth.uid == uid;
      }
      // Posta in arrivo: l'allenamento che un compagno ha fatto con te e ha segnato anche per te.
      // Lo lascia un altro membro, a nome proprio e solo con giorno, durata e fondamentali; non può
      // rileggerlo né cambiarlo. Lo leggi e lo togli solo tu: è la tua app a metterlo nel diario.
      match /inbox/{id} {
        allow read, delete: if isMember() && request.auth.uid == uid;
        allow create: if isMember() && request.auth.uid != uid
          && request.resource.data.keys().hasOnly(['from', 'name', 'date', 'minutes', 'bricks', 'at'])
          && request.resource.data.from == request.auth.uid
          && shortText(request.resource.data, 'name', 120)
          && request.resource.data.date is string && request.resource.data.date.size() == 10
          && request.resource.data.minutes is number
          && request.resource.data.minutes >= 0 && request.resource.data.minutes <= 600
          && (!('bricks' in request.resource.data)
            || (request.resource.data.bricks is list && request.resource.data.bricks.size() <= 20))
          && request.resource.data.at is number;
      }
    }

    // Profilo visibile al gruppo: solo il nome. Medaglie, livello e diario restano personali.
    // Lo scrive solo il proprietario, e non può aggiungere altri campi.
    match /profiles/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'updatedAt'])
        && shortText(request.resource.data, 'name', 120)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is number);
      allow delete: if isMember() && request.auth.uid == uid;
    }
  }
}
